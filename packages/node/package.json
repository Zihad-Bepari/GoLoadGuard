{
  "name": "@goloadguard/node",
  "version": "1.0.0",
  "description": "Production-grade, zero-dependency in-process concurrency control and bounded FIFO backpressure library for Node.js and NestJS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nest": {
      "types": "./dist/nest.guard.d.ts",
      "default": "./dist/nest.guard.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "loadguard",
    "concurrency",
    "backpressure",
    "rate-limit",
    "load-protection",
    "fifo-queue",
    "nestjs-guard"
  ],
  "author": "GoLoadGuard Authors",
  "license": "MIT",
  "peerDependencies": {
    "@nestjs/common": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^12.1.3",
    "@types/node": "^26.6.5",
    "rxjs": "^7.8.2"
  }
}
